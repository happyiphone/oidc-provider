{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Database=oidc;Username=oidc;Password=oidc_dev_only",
    "Redis": "localhost:6379"
  },
  "Oidc": {
    "Issuer": "http://localhost:8080/",
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 14,
    "RefreshReuseLeewaySeconds": 15,
    "Signing": {
      "Mode": "Dev",
      "Kms": {
        "Region": "us-east-1",
        "KeyPropagationMinutes": 10
      }
    }
  }
}
